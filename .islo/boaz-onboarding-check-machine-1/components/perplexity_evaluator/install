#!/bin/sh
set -eu
repo_root="$(cd "$(dirname "$0")/../../../.." && pwd)"
output_dir="/tmp/islo-boaz-onboarding-check-machine-1/perplexity_evaluator"
sudo apt-get update >&2
sudo apt-get install -y python3 python3-venv >&2
mkdir -p "$output_dir"
python3 -m venv "$output_dir/venv"
"$output_dir/venv/bin/pip" install -r "$repo_root/requirements.txt" >&2
